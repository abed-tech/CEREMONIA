# ---- Espace administrateur (domaine séparé, ex. https://admin-ceremonia.example) ----
# URL publique de l'espace admin : toute requête venant d'un autre domaine est refusée.
ADMIN_ORIGIN=https://admin.ceremonia-provisoire.example
# Domaine de l'espace organisateur : jamais servi par cette application.
ORGANIZER_ORIGIN=https://app.ceremonia-provisoire.example

# Projet Supabase (clé publique : autorisée dans le navigateur, protégée par les règles RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé serveur Supabase : UNIQUEMENT côté serveur (limitation des tentatives de connexion).
# Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Déconnexion automatique après inactivité (minutes)
ADMIN_IDLE_MINUTES=30
