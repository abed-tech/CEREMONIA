# ---- Espace organisateur, invitations, contrôleurs et serveurs (domaine séparé de l'admin) ----
# URL publique de cette application : sert aux liens d'invitation, d'accès du personnel et de paiement.
ORGANIZER_ORIGIN=https://app.ceremonia-provisoire.example
# Domaine de l'espace admin : jamais servi par cette application.
ADMIN_ORIGIN=https://admin.ceremonia-provisoire.example

# Projet Supabase (clé publique, protégée par les règles RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Paiement par carte (Stripe) — clé secrète, côté serveur uniquement. Laisser vide pour désactiver ce moyen.
STRIPE_SECRET_KEY=
# Paiement mobile money (CinetPay) — côté serveur uniquement. Laisser vide pour désactiver ce moyen.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
